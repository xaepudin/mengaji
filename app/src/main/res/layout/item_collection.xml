<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:background="@drawable/quran_row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:longClickable="true"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

  <ImageView
      android:id="@+id/collection_badge"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="@drawable/collection_badge_background"
      android:contentDescription="@null"
      android:padding="9dp"
      android:src="@drawable/ic_collection_24"
      app:tint="?attr/quranAccent" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/collection_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TitleText" />

    <TextView
        android:id="@+id/collection_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/sura_details_color"
        android:textSize="14sp" />

  </LinearLayout>

  <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:contentDescription="@null"
      android:src="@drawable/ic_chevron_right_24"
      app:tint="@color/sura_details_color" />

</LinearLayout>
