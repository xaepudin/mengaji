<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/list_header_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

  <ImageView
      android:id="@+id/collections_header_expand"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:contentDescription="@string/collapse_collection"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_expand_less_24" />

  <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:text="@string/quran_collections"
      android:textColor="@color/header_text_color"
      android:textSize="16sp" />

  <ImageButton
      android:id="@+id/collections_header_add"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/collection_new"
      android:src="@drawable/ic_add_24"
      app:tint="@color/header_text_color" />

</LinearLayout>
